msgstr "kandidat di"

msgid "trainees in"
msgstr "trainee di"

msgid "apprentices in"
msgstr "pemagang di"

msgid "finance in"
msgstr "keuangan di"

msgid "A person keeps the same identity as they flow Candidate → Trainee → Apprentice → Post-Apprentice via linking IDs (candidate_id, trainee_id, apprenticeship_order_id)."
msgstr "Satu orang mempertahankan identitas yang sama saat mengalir Kandidat → Trainee → Pemagang → Pasca-Pemagang melalui ID penghubung (candidate_id, trainee_id, apprenticeship_order_id)."

msgid "Access is role-filtered: LPK users only see their own institution's candidates."
msgstr "Akses disaring berdasarkan peran: pengguna LPK hanya melihat kandidat lembaganya sendiri."

