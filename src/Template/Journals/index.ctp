<?php
/**
 * Journal Entries - rich ledger list
 *
 * @var \App\View\AppView $this
 * @var \App\Model\Entity\Journal[]|\Cake\Collection\CollectionInterface $journals
 * @var array $summary      ['total','Draft','Posted','Void','postedDebit','postedCredit']
 * @var string $filterStatus
 */
$this->assign('title', 'Journal Entries');

$money = function ($amount) {
    return 'Rp ' . number_format((float)$amount, 0, ',', '.');
};
$formatDate = function ($value) {
    if ($value instanceof \DateTimeInterface || $value instanceof \Cake\I18n\Date) {
        return $value->format('d M Y');
    }
    $timestamp = $value ? strtotime((string)$value) : false;
    return $timestamp ? date('d M Y', $timestamp) : '-';
};
$journalBadge = function ($status) {
    return $status === 'Posted' ? 'success' : ($status === 'Draft' ? 'warning' : ($status === 'Void' ? 'danger' : 'secondary'));
};
?>

<div class="journals-page">
    <div class="page-header">
        <div>
            <h2><i class="fa fa-book"></i> <?= __('Journal Entries') ?></h2>
            <p class="text-muted"><?= __('General ledger - only Posted entries count in the financial reports') ?></p>
        </div>
        <div class="page-header-actions">
            <?= $this->Html->link('<i class="fa fa-magic"></i> ' . __('Auto-Generate'),
                ['action' => 'autoGenerated'], ['escape' => false, 'class' => 'btn btn-sm btn-primary']) ?>
            <?= $this->Html->link('<i class="fa fa-pencil-square-o"></i> ' . __('Manual Entry'),
                ['action' => 'add'], ['escape' => false, 'class' => 'btn btn-sm btn-success']) ?>
            <?= $this->Html->link('<i class="fa fa-wrench"></i> ' . __('Adjustment'),
                ['action' => 'adjustments'], ['escape' => false, 'class' => 'btn btn-sm btn-outline-secondary']) ?>
            <?= $this->Html->link('<i class="fa fa-bar-chart"></i> ' . __('Reports'),
                ['controller' => 'Reports', 'action' => 'index'],
                ['escape' => false, 'class' => 'btn btn-sm btn-outline-secondary']) ?>
        </div>
    </div>

    <!-- Summary strip -->
    <div class="summary-strip">
        <div class="summary-card summary-total">
            <span class="summary-number"><?= number_format($summary['total']) ?></span>
            <span class="summary-label"><i class="fa fa-book"></i> <?= __('Total Entries') ?></span>
        </div>
        <div class="summary-card summary-posted">
            <span class="summary-number"><?= number_format($summary['Posted']) ?></span>
            <span class="summary-label"><i class="fa fa-check-circle"></i> <?= __('Posted') ?></span>
        </div>
        <div class="summary-card summary-draft">
            <span class="summary-number"><?= number_format($summary['Draft']) ?></span>
            <span class="summary-label"><i class="fa fa-pencil"></i> <?= __('Draft') ?></span>
        </div>
        <div class="summary-card summary-volume">
            <span class="summary-number summary-money"><?= $money($summary['postedDebit']) ?></span>
            <span class="summary-label"><i class="fa fa-money"></i> <?= __('Posted Volume (Debit)') ?></span>
        </div>
    </div>

    <!-- Status filter chips -->
    <div class="filter-chips">
        <span class="chip-label"><i class="fa fa-filter"></i> <?= __('Status:') ?></span>
        <?= $this->Html->link(__('All'), ['action' => 'index'],
            ['class' => 'filter-chip' . ($filterStatus === '' ? ' active' : '')]) ?>
        <?php foreach (['Posted', 'Draft', 'Void'] as $status): ?>
            <?= $this->Html->link(__($status) . ' (' . number_format($summary[$status]) . ')',
                ['action' => 'index', '?' => ['status' => $status]],
                ['class' => 'filter-chip' . ($filterStatus === $status ? ' active' : '')]) ?>
        <?php endforeach; ?>
    </div>

    <?php $rows = iterator_to_array($journals); ?>
    <?php if (!empty($rows)): ?>
        <div class="card">
            <div class="table-scroll-wrapper" style="overflow-x: auto; -webkit-overflow-scrolling: touch;">
                <table class="table rich-table">
                    <thead>
                        <tr>
                            <th class="actions"><?= __('Actions') ?></th>
                            <th><?= $this->Paginator->sort('transaction_date', __('Date')) ?></th>
                            <th><?= $this->Paginator->sort('reference_no', __('Reference')) ?></th>
                            <th><?= __('Description') ?></th>
                            <th class="text-right"><?= $this->Paginator->sort('total_debit', __('Debit')) ?></th>
                            <th class="text-right"><?= $this->Paginator->sort('total_credit', __('Credit')) ?></th>
                            <th><?= __('Balanced') ?></th>
                            <th><?= $this->Paginator->sort('status', __('Status')) ?></th>
                        </tr>
                    </thead>
                    <tbody>
                        <?php foreach ($rows as $row): ?>
                        <?php $balanced = (float)$row['total_debit'] === (float)$row['total_credit']; ?>
                        <tr>
                            <td class="actions">
                                <?= $this->Html->link('<i class="fa fa-eye"></i>', ['action' => 'view', $row['id']],
                                    ['escape' => false, 'class' => 'btn btn-sm btn-outline-info', 'title' => __('View')]) ?>
                                <?= $this->Html->link('<i class="fa fa-edit"></i>', ['action' => 'edit', $row['id']],
                                    ['escape' => false, 'class' => 'btn btn-sm btn-outline-primary', 'title' => __('Edit')]) ?>
                            </td>
                            <td><?= h($formatDate($row['transaction_date'])) ?></td>
                            <td><strong><?= h($row['reference_no'] ?: ('#' . $row['id'])) ?></strong></td>
                            <td class="desc-cell" title="<?= h($row['description']) ?>"><?= h($row['description'] ?: '-') ?></td>
                            <td class="text-right"><?= $money($row['total_debit']) ?></td>
                            <td class="text-right"><?= $money($row['total_credit']) ?></td>
                            <td>
                                <?php if ($balanced): ?>
                                    <span class="balance-chip balance-ok"><i class="fa fa-check"></i> <?= __('Balanced') ?></span>
                                <?php else: ?>
                                    <span class="balance-chip balance-off" title="<?= __('Debit and credit totals differ') ?>">
                                        <i class="fa fa-exclamation-triangle"></i> <?= $money(abs((float)$row['total_debit'] - (float)$row['total_credit'])) ?>
                                    </span>
                                <?php endif; ?>
                            </td>
                            <td><span class="badge badge-<?= $journalBadge($row['status']) ?>"><?= h($row['status']) ?></span></td>
                        </tr>
                        <?php endforeach; ?>
                    </tbody>
                </table>
            </div>
        </div>

        <div class="paginator" style="margin-top: 15px;">
            <ul class="pagination">
                <?= $this->Paginator->first('<< ' . __('first')) ?>
                <?= $this->Paginator->prev('< ' . __('previous')) ?>
                <?= $this->Paginator->numbers() ?>
                <?= $this->Paginator->next(__('next') . ' >') ?>
                <?= $this->Paginator->last(__('last') . ' >>') ?>
            </ul>
            <p><?= $this->Paginator->counter(['format' => __('Page {{page}} of {{pages}}, showing {{current}} record(s) out of {{count}} total')]) ?></p>
        </div>
    <?php else: ?>
        <div class="card">
            <div class="empty-state">
                <i class="fa fa-book fa-4x"></i>
                <h4><?= $filterStatus ? __('No {0} entries.', $filterStatus) : __('No journal entries yet.') ?></h4>
                <p class="text-muted"><?= __('Record debits and credits here - Posted entries feed the Income Statement, Balance Sheet and Cash Flow.') ?></p>
                <div>
                    <?= $this->Html->link('<i class="fa fa-plus-circle"></i> ' . __('Add Entry'),
                        ['action' => 'add'], ['escape' => false, 'class' => 'btn btn-success']) ?>
                    <?php if ($filterStatus): ?>
                        <?= $this->Html->link(__('Show All'), ['action' => 'index'], ['class' => 'btn btn-outline-secondary']) ?>
                    <?php endif; ?>
                </div>
            </div>
        </div>
    <?php endif; ?>
</div>

