    padding: 5px 14px;
    border-radius: 15px;
    border: 1.5px solid #e0e0e0;
    background: #f5f5f5;
    color: #546e7a;
    text-decoration: none;
    font-size: 0.88em;
    font-weight: bold;
}
.filter-chip:hover { border-color: #667eea; text-decoration: none; }
